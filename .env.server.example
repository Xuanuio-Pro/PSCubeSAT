SITE_DOMAIN=cubesat.p-tech.xyz
# Use pscubesat when replacing the existing server stack; keep its project name.
SERVER_PROJECT=pscubesat-next
# Unique image tag for this release; preserve the previous tag for rollback.
RELEASE_TAG=2026-10-21
# Existing host proxy/tunnel can route to http://127.0.0.1:5180.
FRONTEND_PORT=5180
BACKEND_ENV_FILE=./fastapi-backend/.env
# Only needed with docker-compose.proxy.yml for a Docker-based ingress.
PROXY_NETWORK=
# Only with --tunnel when replacing the connector owned by the SAME Compose project.
# This existing file contains TUNNEL_TOKEN; it stays outside Git.
TUNNEL_ENV_FILE=./.env
# Only needed with docker-compose.database.yml for an existing PostgreSQL container.
# DATABASE_URL must use its hostname/alias and internal port, usually 5432.
DATABASE_NETWORK=
# Only for a NEW database with docker-compose.postgres.yml (not the external DB).
# Generate a password once, retain it with this project's PostgreSQL volume.
POSTGRES_DB=cubesat
POSTGRES_USER=cubesat
POSTGRES_PASSWORD=
