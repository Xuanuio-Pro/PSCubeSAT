{
  "name": "ptit-stem-cube",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run dev:db && npm run dev:services && npm run db:migrate",
    "predev:be": "npm run dev:db && npm run dev:services && npm run db:migrate",
    "db:migrate": "cd fastapi-backend && C:/Users/Xuanuio/miniconda3/envs/stemcube/python.exe -m alembic upgrade head",
    "dev:db": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1",
    "dev:db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1 -Stop",
    "dev": "concurrently -n \"FE,BE\" -c \"cyan,magenta\" \"vite\" \"cd fastapi-backend && C:/Users/Xuanuio/miniconda3/envs/stemcube/python.exe dev.py\"",
    "dev:fe": "vite",
    "dev:be": "cd fastapi-backend && C:/Users/Xuanuio/miniconda3/envs/stemcube/python.exe dev.py",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "test:be": "cd fastapi-backend && C:/Users/Xuanuio/miniconda3/envs/stemcube/python.exe -m unittest discover -s app/tests -p test_*.py",
    "test:telemetry": "node --test tests/telemetry.test.js",
    "telemetry:schema": "C:/Users/Xuanuio/miniconda3/envs/stemcube/python.exe scripts/export-telemetry-schema.py",
    "telemetry:schema:check": "npm run telemetry:schema -- --check",
    "check": "npm run lint && npm run typecheck && npm run telemetry:schema:check && npm run test:blockly && npm run test:flash && npm run test:telemetry && npm run test:be",
    "test:blockly": "node --test tests/blockly.test.js",
    "test:blockly:runtime": "node scripts/blockly-runtime-test.mjs",
    "test:blockly:compile": "node scripts/blockly-smoke.mjs && C:/Users/Xuanuio/miniconda3/envs/stemcube/python.exe scripts/blockly-compile-matrix.py",
    "preview": "vite preview",
    "dev:services": "cd fastapi-backend && C:/Users/Xuanuio/miniconda3/envs/stemcube/python.exe local_services.py",
    "test:flash": "node --test tests/flash-artifact.test.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.185.1",
    "blockly": "^13.2.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "esptool-js": "^0.6.0",
    "leaflet": "^1.9.4",
    "mqtt": "^5.15.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-grid-layout": "^2.2.4",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable": "^4.0.2",
    "react-router": "^6.28.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1",
    "satellite.js": "^7.0.1",
    "spark-md5": "^3.0.2",
    "three": "^0.185.1",
    "uplot": "^1.6.32",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
