# ── FastAPI Server ─────────────────────────────────────────────
PORT=8005

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── PostgreSQL ─────────────────────────────────────────────────
DATABASE_URL=postgresql://cubesat:your_password@localhost:5432/cubesat

# ── CORS (Frontend origins) ────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5175,http://localhost:5173,http://localhost:4173

# ── MQTT ────────────────────────────────────
MQTT_HOST=mqtt.p-tech.xyz
MQTT_PORT=8883
MQTT_USERNAME=backend-service
MQTT_PASSWORD=
MQTT_TOPIC=sensors/#
MQTT_TLS=true
# Keep true normally; false explicitly skips certificate verification for development.
MQTT_TLS_VERIFY=true
# Empty uses public CA trust. Relative paths are resolved from fastapi-backend.
MQTT_CA_FILE=
MQTT_ADMIN_USERNAME=
MQTT_ADMIN_PASSWORD=

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_secret_in_production

# Built separately: docker build -f compiler/Dockerfile -t pscubesat-compiler:1 .
# No local PlatformIO fallback. API needs access to a trusted Docker daemon.
COMPILER_IMAGE=pscubesat-compiler:1
JWT_EXPIRE_MINUTES=1440

# Google OAuth 2.0 Web application Client ID (public, no client secret needed)
GOOGLE_CLIENT_ID=
