# ── FastAPI Server ─────────────────────────────────────────────
PORT=8005

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── PostgreSQL ─────────────────────────────────────────────────
# Defaults match `npm run dev:db:docker` (docker-compose.dev.yml, dev-only passwords).
DATABASE_URL=postgresql://cubesat:cubesat_dev@localhost:5432/cubesat
# Only for opt-in PostgreSQL tests/load test: role `cubesat` and superuser `postgres` on 127.0.0.1:5432.
POSTGRES_PASSWORD=cubesat_dev
POSTGRES_ADMIN_PASSWORD=postgres_dev

# ── CORS (Frontend origins) ────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5175,http://localhost:5173,http://localhost:4173
# Real client IP header from a trusted edge, used by rate limits. Set CF-Connecting-IP only
# when all traffic arrives through Cloudflare (tunnel); leave empty behind Caddy or locally.
CLIENT_IP_HEADER=

# ── MQTT ────────────────────────────────────
# localhost:1883 lets `npm run dev` start a local Mosquitto (Docker) with a generated password.
# Shared broker instead: MQTT_HOST=mqtt.p-tech.xyz, MQTT_PORT=8883, MQTT_TLS=true + team password.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=backend-service
MQTT_PASSWORD=
MQTT_TOPIC=sensors/#
MQTT_TLS=false
# Keep true normally; false explicitly skips certificate verification for development.
MQTT_TLS_VERIFY=true
# Empty uses public CA trust. Relative paths are resolved from fastapi-backend.
MQTT_CA_FILE=
MQTT_ADMIN_USERNAME=
MQTT_ADMIN_PASSWORD=

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_secret_in_production

# Built separately: docker build -f compiler/Dockerfile -t pscubesat-compiler:1 .
# No local PlatformIO fallback. API needs access to a trusted Docker daemon.
COMPILER_IMAGE=pscubesat-compiler:1
JWT_EXPIRE_MINUTES=1440

# Google OAuth 2.0 Web application Client ID (public, no client secret needed)
GOOGLE_CLIENT_ID=

# Class-based LMS (classes, learning path, Lab Test). false = legacy /lab0-/lab8 flow only.
LMS_CLASS_MODE=false

# Optional server-only draft-question generator. Empty key hides the feature.
QUIZ_AI_PROVIDER=openai_compatible
QUIZ_AI_KEY=
QUIZ_AI_MODEL=
QUIZ_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# Operator-estimated maximum cost per call; reserve this amount also on retries.
# Configure conservatively for <=40k source characters and <=10k output tokens.
QUIZ_AI_MAX_CALL_USD=
QUIZ_AI_DAILY_USD=
