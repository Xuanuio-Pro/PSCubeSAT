APP_ENV=production
# Reuse the production DB only AFTER backup + a successful migration rehearsal on a clone.
# URL-encode special characters in username/password. localhost means this container.
DATABASE_URL=postgresql://cubesat:<URL_ENCODED_PASSWORD>@<DB_HOST>:5432/cubesat
# Reuse the existing server's strong JWT secret to preserve login sessions,
# or generate a new one (users must sign in again): python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<REPLACE_WITH_UNIQUE_SECRET_AT_LEAST_32_CHARACTERS>
JWT_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=

MQTT_HOST=mqtt.p-tech.xyz
MQTT_PORT=8883
MQTT_USERNAME=backend-service
MQTT_PASSWORD=<BROKER_SERVICE_PASSWORD>
MQTT_TOPIC=sensors/#
MQTT_TLS=true
MQTT_TLS_VERIFY=true
MQTT_CA_FILE=
# Device credentials and ACLs are stored in PostgreSQL, not provisioned through 18083.
MQTT_ADMIN_USERNAME=
MQTT_ADMIN_PASSWORD=

COMPILER_IMAGE=pscubesat-compiler:2026-10-21
# Compose supplies REDIS_URL and the exact HTTPS ALLOWED_ORIGINS.
REDIS_URL=redis://redis:6379
ALLOWED_ORIGINS=https://cubesat.p-tech.xyz
