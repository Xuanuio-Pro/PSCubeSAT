[Unit]
Description=CubeSat FastAPI Backend (PlatformIO Compiler + MQTT Consumer + WebSocket)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=sonar2
WorkingDirectory=/home/sonar2/Desktop/PTIT-STEM-CUBE/fastapi-backend
ExecStart=/home/sonar2/miniconda3/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8088
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
