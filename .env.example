# 🚀 PTIT-STEM-CUBE FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE

# Production Domain / API URLs (Optional - auto-detects current domain if omitted)
# FE uses same-origin /api and /ws by default, including when served over HTTPS.
# Only set VITE_WS_URL for an intentionally separate WebSocket origin.
VITE_WS_URL=

# docker-compose.production.yml / Caddy. Set DNS A/AAAA to your server first.
# This is a server-only value; it is not a VITE_* build variable.
SITE_DOMAIN=cubesat.p-tech.xyz

# Optional local Vite HTTPS; both paths are required, and clients must trust the CA.
DEV_HTTPS_CERT=
DEV_HTTPS_KEY=

# Use a unique project name and host ports when running multiple clones on one machine.
COMPOSE_PROJECT_NAME=pscubesat-dev
DEV_POSTGRES_PORT=5432
DEV_REDIS_PORT=6379
DEV_MQTT_PORT=1883
VITE_DEV_PORT=5175
VITE_BACKEND_PORT=8005

# MQTT service credentials belong in fastapi-backend/.env, never VITE_* variables.
